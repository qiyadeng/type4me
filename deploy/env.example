# Copy to /etc/type4me-relay/env (owner root:type4me, mode 0640)
# Generate ADMIN_TOKEN via: openssl rand -base64 48 | tr -d '=' | head -c 64

TYPE4ME_RELAY_ADMIN_TOKEN=REPLACE_WITH_RANDOM_64_CHARS
TYPE4ME_RELAY_BIND=127.0.0.1:8443
TYPE4ME_RELAY_STATE_DIR=/var/lib/type4me-relay

# Self-service accounts: comma-separated set of invite codes. Empty disables registration (register returns 403).
TYPE4ME_RELAY_INVITE_CODES=

# HMAC signing key for session tokens (any long random string; pin it in production).
# If empty, a random key is generated on each startup — all sessions invalidate on restart (device tokens are unaffected).
TYPE4ME_RELAY_SESSION_KEY=
